#!/usr/bin/bash
# Installs what Omascayl is missing. The app runs this in Omarchy's presented
# terminal (omarchy launch floating terminal with presentation), so there is
# somewhere to answer and pacman has somewhere to ask for a password; neither
# can happen inside omarchy-shell, where the plugin runs.
#
# It shows what it will install and asks once, "Proceed? [Y/n]". The Upscayl
# engine and models are downloaded into the user's own data folder (no
# password); anything else missing comes from the Arch repositories.
set -uo pipefail

# Commands resolve from a fixed, verified set rather than the inherited PATH:
# only root-owned directories that nobody else can write to. (The same check as
# Omarchroma's setup; see there for the reasoning behind each part.)
omascayl_trusted_path() {
  local directory owner mode trusted="" unmapped="" overflow inside count
  if [[ -r /proc/self/uid_map ]] && overflow=$(</proc/sys/kernel/overflowuid); then
    unmapped=$overflow
    while read -r inside _ count; do
      (( overflow >= inside && overflow < inside + count )) && unmapped=""
    done < /proc/self/uid_map
  fi
  for directory in /usr/bin /usr/share/omarchy/bin; do
    [[ -d $directory ]] || continue
    read -r owner mode < <(/usr/bin/stat -Lc '%u %a' "$directory" 2>/dev/null) || continue
    [[ $owner == 0 || ( -n $unmapped && $owner == "$unmapped" ) ]] || continue
    (( (8#$mode & 8#022) == 0 )) || continue
    trusted="${trusted:+$trusted:}$directory"
  done
  printf '%s' "${trusted:-/usr/bin:/usr/share/omarchy/bin}"
}
PATH=$(omascayl_trusted_path)
export PATH

here=$(cd -- "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")" && pwd)
data=${XDG_DATA_HOME:-$HOME/.local/share}
state=${XDG_STATE_HOME:-$HOME/.local/state}/omascayl
backend_dir="$data/omascayl/backend"

# --- the pinned backend download ----------------------------------------------
# The engine is upscayl-ncnn's own Linux release; the models are the seven that
# ship with Upscayl, from one fixed commit of its repository (the same files as
# the AUR upscayl-bin package's). Every file is checked against the SHA-256
# below before it is used; a mismatch stops the download and keeps nothing.
ENGINE_TAG=20251207-174704
ENGINE_URL="https://github.com/upscayl/upscayl-ncnn/releases/download/$ENGINE_TAG/upscayl-bin-$ENGINE_TAG-linux.zip"
ENGINE_ZIP_SHA256=a9fab3c770b62f2b7a35d8d6d61eb4e8b3aef79128b665c919d080b85a2292f2
ENGINE_BIN_SHA256=8b0980197d5bdb6fc4fbc0cc50dae721f3df18d91d0d912ec0a3aeea6495367e
MODELS_REV=e1aeaf1217b6061b4212b87c9fd421984f73e437
MODELS_URL="https://raw.githubusercontent.com/upscayl/upscayl/$MODELS_REV/resources/models"
CURL_PROTO="=https"
MODELS=(
  "digital-art-4x.param 2b8fb6e0ae4d2d85704ca08c119a2f5ea40add4f2ecd512eb7f4cd44b6127ed4"
  "digital-art-4x.bin fe01c269cfd10cdef8e018ab66ebe750cf79c7af4d1f9c16c737e1295229bacc"
  "high-fidelity-4x.param 4576ed5c2fc5fa250d3c3d585ef02248f26abdfc1867088078f501fe71e5d61e"
  "high-fidelity-4x.bin 8a135402b4f39286121b76abb47601a6b7b7e8d4f3e999a5aaa45ed277824fb4"
  "remacri-4x.param 859ecba5b3592ecf3e76c93bed65e9f627b5236dd696aae5a84ecf8c93ab65ce"
  "remacri-4x.bin a43be595c0d743314c30b50fe7ef188be0c61cc55c46ce81adb79ba4b3c3fb7a"
  "ultramix-balanced-4x.param 859ecba5b3592ecf3e76c93bed65e9f627b5236dd696aae5a84ecf8c93ab65ce"
  "ultramix-balanced-4x.bin 171cae5968485d366b4fb575d232f98d117d94b766b15f22849cfccde40d2050"
  "ultrasharp-4x.param 0136ca83686809a8f17f7111f11b951e8db93610e24b7f4137c9ffe4dbc4a806"
  "ultrasharp-4x.bin fb3e279d40d4cddb44db4e684d59e68d0aa39852c8cc14dc3f23ccc7e6eee9c1"
  "upscayl-lite-4x.param 22174924330297357434ad21ed0af7f4b820008d2a502b492754d130d4142714"
  "upscayl-lite-4x.bin 85ee266b632a765a725425ba6a5620c088c8aa2939a03063b2d83b3462724cc1"
  "upscayl-standard-4x.param 35330ececcea33b6c397a72548e788d5d53becee4734c50b7fada36e89f10a86"
  "upscayl-standard-4x.bin 713ee713b0353afaa27976f0563a64a5043bd70b9bd8936c2e26e25ebcdbcddf"
)

bold=$'\033[1m'; dim=$'\033[2m'; reset=$'\033[0m'; warn=$'\033[1;33m'; good=$'\033[32m'; bad=$'\033[31m'
say()   { printf '%s\n' "$*"; }
head2() { printf '\n%s%s%s\n' "$bold" "$*" "$reset"; }
note()  { printf '%s%s%s\n' "$dim" "$*" "$reset"; }

# The open Omascayl window watches ~/.local/state/omascayl/setup-finished and
# checks again when it changes, however this script ends. omascayl-store writes
# it without following symlinks.
work=""
finish() {
  [[ -n $work ]] && rm -rf -- "$work"
  "$here/omascayl-store" finished || true
}
trap finish EXIT

# --- what is missing ------------------------------------------------------------
declare -A state_of pkgs_of label_of
keys=()
while IFS=$'\t' read -r st key need label pkgs why; do
  [[ -n $key ]] || continue
  keys+=("$key"); state_of[$key]=$st; pkgs_of[$key]=$pkgs; label_of[$key]=$label
done < <("$here/omascayl-deps")
missing() { [[ ${state_of[$1]:-ok} == missing ]]; }

say "${bold}Omascayl setup${reset}"

download=false
missing backend && download=true

# The only packages this script ever asks pacman for. Names reported by
# omascayl-deps are checked against this list, so nothing else (an option, a
# package from another repository) can reach the sudo command line.
ALLOWED_PKGS=(vulkan-icd-loader vulkan-radeon vulkan-intel python python-gobject
  xdg-desktop-portal xdg-desktop-portal-gtk wl-clipboard libnotify xdg-utils curl unzip)
pacman_pkgs=()
refused=()
add_pkgs() {
  local p
  for p in "$@"; do
    [[ $p == - || " ${pacman_pkgs[*]} " == *" $p "* ]] && continue
    if [[ " ${ALLOWED_PKGS[*]} " == *" $p "* ]]; then pacman_pkgs+=("$p"); else refused+=("$p"); fi
  done
}

# Vulkan: the loader, plus the driver for the GPU(s) found. NVIDIA's driver has
# to match the installed kernel driver, so it is left to the user.
nvidia_note=false
if missing vulkan; then
  [[ ${pkgs_of[vulkan]} != - ]] && add_pkgs vulkan-icd-loader
  for vendor_file in /sys/class/drm/card*/device/vendor; do
    [[ -r $vendor_file ]] || continue
    case $(<"$vendor_file") in
      0x1002) pacman -Qq vulkan-radeon &>/dev/null || add_pkgs vulkan-radeon ;;
      0x8086) pacman -Qq vulkan-intel &>/dev/null || add_pkgs vulkan-intel ;;
      0x10de) nvidia_note=true ;;
    esac
  done
fi

for key in picker clipboard notify open; do
  missing "$key" || continue
  read -r -a p <<< "${pkgs_of[$key]}"
  add_pkgs "${p[@]}"
done

if $download; then
  for tool in curl unzip; do command -v "$tool" >/dev/null || add_pkgs "$tool"; done
fi

if (( ${#refused[@]} )); then
  say "${bad}Not installing unexpected package names:${reset} ${refused[*]}"
  exit 1
fi

if ! $download && (( ${#pacman_pkgs[@]} == 0 )); then
  say ""
  if $nvidia_note; then
    say "Install the Vulkan driver for your NVIDIA GPU (nvidia-utils, matching your driver), then run this again."
    exit 1
  fi
  say "${good}Everything Omascayl needs is installed.${reset}"
  exit 0
fi

# --- the plan, and one question -----------------------------------------------------
say ""
say "This will install:"
$download && say "  - Upscayl's engine and AI models (about 175 MB download, into $backend_dir)"
(( ${#pacman_pkgs[@]} )) && say "  - ${pacman_pkgs[*]} (from the Arch repositories; asks for your password)"
$nvidia_note && note "  NVIDIA GPU: install its Vulkan driver (nvidia-utils, matching your driver) yourself."
say ""
printf 'Proceed? [Y/n] '
read -r answer
case ${answer,,} in
  ""|y|yes) ;;
  *) say "Nothing was changed."; exit 1 ;;
esac

# --- doing it --------------------------------------------------------------------------
failed=()

if (( ${#pacman_pkgs[@]} )); then
  head2 "Installing packages"
  sudo pacman -S --needed --noconfirm -- "${pacman_pkgs[@]}" || failed+=("pacman did not finish")
fi

fetch() {  # url dest sha256
  curl -fL --proto "$CURL_PROTO" --tlsv1.2 --retry 2 --progress-bar -o "$2" "$1" || return 1
  [[ $(sha256sum -- "$2" | cut -d' ' -f1) == "$3" ]] || { say "${bad}Checksum mismatch: $(basename -- "$2")${reset}"; return 1; }
}

install_backend() {
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/omascayl
  mkdir -p -- "$cache" || return 1
  work=$(mktemp -d -p "$cache") || return 1
  local stage="$work/backend"
  mkdir -p -- "$stage/models"
  say "Engine $ENGINE_TAG"
  fetch "$ENGINE_URL" "$work/engine.zip" "$ENGINE_ZIP_SHA256" || return 1
  unzip -q -o "$work/engine.zip" -d "$work/engine" || return 1
  local bin
  bin=$(find "$work/engine" -type f -name upscayl-bin | head -n1)
  [[ -n $bin && $(sha256sum -- "$bin" | cut -d' ' -f1) == "$ENGINE_BIN_SHA256" ]] ||
    { say "${bad}The engine in the download is not the expected file.${reset}"; return 1; }
  install -m 755 -- "$bin" "$stage/upscayl-bin"
  local entry name sha checked=("upscayl-bin=$ENGINE_BIN_SHA256")
  for entry in "${MODELS[@]}"; do
    read -r name sha <<< "$entry"
    say "Model $name"
    fetch "$MODELS_URL/$name" "$stage/models/$name" "$sha" || return 1
    checked+=("models/$name=$sha")
  done
  # omascayl-store copies each file into a new folder, checking its SHA-256
  # again on the bytes it copies, and swaps that in only once all matched.
  "$here/omascayl-store" place-backend "$stage" "$(printf 'engine %s\nmodels %s' "$ENGINE_TAG" "$MODELS_REV")" "${checked[@]}"
}

if $download; then
  head2 "Downloading the Upscayl engine and models"
  if command -v curl >/dev/null && command -v unzip >/dev/null; then
    install_backend || failed+=("the download did not finish; nothing was kept")
  else
    failed+=("curl and unzip are needed for the download")
  fi
fi

# --- result ------------------------------------------------------------------------------
head2 "Result"
"$here/omascayl-deps" | while IFS=$'\t' read -r st key need label pkgs why; do
  if [[ $st == ok ]]; then printf '  %s✓%s %s\n' "$good" "$reset" "$label"
  else printf '  %s✗%s %s (%s)\n' "$bad" "$reset" "$label" "$need"; fi
done
for f in "${failed[@]}"; do say "${warn}Not done:${reset} $f"; done
(( ${#failed[@]} )) && exit 1
say ""
note "Omascayl checks again on its own; there is nothing to restart."
